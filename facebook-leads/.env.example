# Backend/Railway only. Never put these in Web or SwiftUI.
# Dedicated Meta app; must differ from FOCUS_META_APP_ID to preserve its callback.
FACEBOOK_LEADS_APP_ID=
FACEBOOK_LEADS_APP_SECRET=
FACEBOOK_LEADS_LOGIN_CONFIG_ID=
FACEBOOK_LEADS_REDIRECT_URI=https://wolfcrm-backend-production.up.railway.app/api/integrations/facebook-leads/oauth/callback
FACEBOOK_LEADS_GRAPH_VERSION=v25.0
# Generate independently: openssl rand -base64 32
FACEBOOK_LEADS_VERIFY_TOKEN=
FACEBOOK_LEADS_ENCRYPTION_KEY=
FACEBOOK_LEADS_WORKER_ENABLED=false
# Optional fixed HTTPS desktop /settings return URL
FACEBOOK_LEADS_WEB_RETURN_URL=
