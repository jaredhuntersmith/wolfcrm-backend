# Names only. Store actual values in Railway service variables or a private local file.
# The existing API keeps DATABASE_URL, authentication, Connect, APNs and CRM data.
QUOTE_PUBLIC_BASE_URL=
# Generate a durable random value of at least 32 bytes. Back up separately;
# changing it invalidates every existing customer link.
QUOTE_LINK_SECRET=

# Use a separate staging/test configuration. Never copy live credentials into tests.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Existing optional platform fee setting, basis points; 0 means no platform fee.
STRIPE_PLATFORM_FEE_BPS=0

# Existing database configuration; agreement PDFs/evidence use durable PostgreSQL.
DATABASE_URL=
DB_SSL=true
